{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Red Anchor Sentinel",
  "version": "9.1.0",
  "identifier": "world.space2.redanchor.sentinel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "node scripts/export-desktop.mjs",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "红锚哨兵",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": [
      "../server/host.mjs",
      "../server/host-cli.mjs",
      "../server/activation-mail.mjs",
      "../server/lab-desk.mjs",
      "../server/ask.mjs",
      "../server/discover.mjs"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
